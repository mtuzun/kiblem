<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_full_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <ImageView
      android:id="@+id/widget_background_image"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:src="@drawable/widget_background"
      android:scaleType="fitXY"
      android:importantForAccessibility="no" />
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="12dp">
    <!-- Üst satır: solda etiket, sağda (ayar düğmesinin yanında) günün hava durumu. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingRight="32dp">
    <TextView
        android:id="@+id/widget_full_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:textColor="#D9FFFFFF"
        android:textSize="13sp"
        tools:text="İmsak vaktine kalan süre" />
    <TextView
        android:id="@+id/widget_full_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="6dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Açık · 14/14°" />
    </LinearLayout>
    <!-- Geri sayım satırı: solda süre, sağda şu anki saat. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
    <Chronometer android:id="@+id/widget_full_chronometer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:includeFontPadding="false" android:textColor="#FFFFFF" android:textSize="30sp" android:textStyle="bold" android:fontFamily="monospace" tools:text="06:39:12" />
    <!-- API 24 altı cihazlarda canlı Chronometer yerine bu statik metin kullanılır. -->
    <TextView
        android:id="@+id/widget_full_countdown_fallback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:visibility="gone"
        tools:text="06:39:12" />
    <TextClock
        android:id="@+id/widget_full_clock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginLeft="8dp"
        android:gravity="end"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="16:25" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_full_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_date_chip"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:includeFontPadding="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        tools:text="10 Ekim 2026   29 Rebi-ül Ahir 1448" />
    <LinearLayout
        android:id="@+id/widget_prayer_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:weightSum="6">
      <LinearLayout
          android:id="@+id/widget_slot_0"
          style="@style/WidgetPrayerSlot">
        <TextView
            android:id="@+id/widget_slot_name_0"
            style="@style/WidgetPrayerSlotName"
            tools:text="İmsak" />
        <TextView
            android:id="@+id/widget_slot_time_0"
            style="@style/WidgetPrayerSlotTime"
            tools:text="05:39" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/widget_slot_1"
          style="@style/WidgetPrayerSlot">
        <TextView
            android:id="@+id/widget_slot_name_1"
            style="@style/WidgetPrayerSlotName"
            tools:text="Güneş" />
        <TextView
            android:id="@+id/widget_slot_time_1"
            style="@style/WidgetPrayerSlotTime"
            tools:text="07:03" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/widget_slot_2"
          style="@style/WidgetPrayerSlot">
        <TextView
            android:id="@+id/widget_slot_name_2"
            style="@style/WidgetPrayerSlotName"
            tools:text="Öğle" />
        <TextView
            android:id="@+id/widget_slot_time_2"
            style="@style/WidgetPrayerSlotTime"
            tools:text="12:56" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/widget_slot_3"
          style="@style/WidgetPrayerSlot">
        <TextView
            android:id="@+id/widget_slot_name_3"
            style="@style/WidgetPrayerSlotName"
            tools:text="İkindi" />
        <TextView
            android:id="@+id/widget_slot_time_3"
            style="@style/WidgetPrayerSlotTime"
            tools:text="16:04" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/widget_slot_4"
          style="@style/WidgetPrayerSlot">
        <TextView
            android:id="@+id/widget_slot_name_4"
            style="@style/WidgetPrayerSlotName"
            tools:text="Akşam" />
        <TextView
            android:id="@+id/widget_slot_time_4"
            style="@style/WidgetPrayerSlotTime"
            tools:text="18:39" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/widget_slot_5"
          style="@style/WidgetPrayerSlot">
        <TextView
            android:id="@+id/widget_slot_name_5"
            style="@style/WidgetPrayerSlotName"
            tools:text="Yatsı" />
        <TextView
            android:id="@+id/widget_slot_time_5"
            style="@style/WidgetPrayerSlotTime"
            tools:text="19:57" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <ImageButton
      android:id="@+id/widget_settings_button"
      android:layout_width="36dp"
      android:layout_height="36dp"
      android:layout_gravity="top|end"
      android:layout_marginRight="4dp"
      android:layout_marginTop="2dp"
      android:background="@android:color/transparent"
      android:src="@drawable/widget_settings_icon"
      android:padding="8dp"
      android:contentDescription="Widget görünüm ayarları" />
</FrameLayout>
